@page "Clientes/DetailsDebt"
@model DetailsDebtModel
@{
    var name = $"{Model.Input.DataClient.Nombre} {Model.Input.DataClient.Apellido}";
    var debt = $"{Model.Input.Money}{String.Format("{0:#,###,###,##0,00####}", Model.Input.DataClient.Debt)}";
    var payment = $"{Model.Input.Money}{String.Format("{0:#,###,###,##0,00####}", Model.Input.DataClient.Payment)}";
    var monthly = $"{Model.Input.Money}{String.Format("{0:#,###,###,##0,00####}", Model.Input.DataClient.Monthly)}";
    var currentDebt = $"{Model.Input.Money}{String.Format("{0:#,###,###,##0,00####}", Model.Input.DataClient.CurrentDebt)}";
    var ID = $"{Model.Input.Money}{String.Format("{0:#,###,###,##0,00####}", Model.Input.DataClient.IdCliente)}";
}
<div class="container">
    <div class="row">
        <h1>@name</h1>
        <div class="col-sm">
            <div class="card text-center" style="width: 21rem;">
                <div class="card-header">
                    <h5>Reporte de Pagos</h5>
                </div>
                <div  class="card-body">
                    <div class="col-md-10">
                        <div class="row">
                            <p>Deuda:</p>
                            &nbsp;
                            <p>@debt</p>
                        </div>
                        <div class="row">
                            <p>Fecha Deuda:</p>
                            &nbsp;
                            <p>@Model.Input.DataClient.DateDebt.ToString("dd/MMM/yyy")</p>
                        </div>
                        <div class="row">
                            <p>Pago:</p>
                            &nbsp;
                            <p>@payment</p>
                        </div>
                        <div class="row">
                            <p>Fecha del Pago:</p>
                            &nbsp;
                            <p>@Model.Input.DataClient.Date.ToString("dd/MMM/yyy")</p>
                        </div>
                        <div class="row">
                            <p>Cuotas por meses:</p>
                            &nbsp;
                            <p>@monthly</p>
                        </div>
                        <div class="row">
                            <p>Deuda Actual:</p>
                            &nbsp;
                            <p>@currentDebt</p>
                        </div>
                        <div class="row">
                            <p>Ticket:</p>
                            &nbsp;
                            <p>@Model.Input.DataClient.Ticket</p>
                        </div>
                        <div class="row">
                            <p>Usuario:</p>
                            &nbsp;
                            <p>@Model.Input.DataClient.User</p>
                        </div>
                        <div class="row">
                            <form asp-area="Clientes" asp-page="DetailsDebt" method="post">
                                <input type="submit" value="Ticket" class="btn-sm btn btn-outline-info" />
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

