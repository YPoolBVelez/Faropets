@model DataPaginador<RegistroModelInput>
@{
    ViewData["Title"] = "Clientes";
}
<div class="container p-4">
    <div class="row">
        <div class="form-group">
            <form asp-area="Users" asp-controller="Clientes" asp-action="Clientes" method="get">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-12">
                            <input type="text" id="filtrar" name="filtrar" placeholder="Buscar" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-4">
                            <input type="submit" value="Buscar" class="btn btn-outline-success" />
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
    &nbsp;
    <div class="row">
        @foreach (var item in Model.List)
        {
            var image = "data:image/jpg:base64," + Convert.ToBase64String(item.Image, 0, item.Image.Length);
            <div class="col-xs-6 col-md-2">
                <div class="card text-center">
                    <div class="card-header">
                        <a asp-route-id="@item.IdCliente" asp-area="Clientes" asp-page="/Account/Details">
                            <img class="imageUsers" src="@image" />
                        </a>
                    </div>
                    <div class="card-body text-center">
                        <div class="col-md-10">
                            <div class="row">
                                <p>@Html.DisplayFor(modelItem => item.Nombre)</p>
                            </div>
                            <div class="row">
                                <p>Role:</p>
                                &nbsp;
                                <p>@Html.DisplayFor(modelItem => item.Apellido)</p>
                            </div>
                            <div class="row">
                                <a class="btn btn-outline-success" asp-route-id="@item.IdCliente" asp-area="Users" asp-page="/Account/Details">Detalle</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<div>
    Resultados @Html.Raw(Model.pagi_info);
    <br />
    @Html.Raw(Model.pagi_navegacion);
</div>